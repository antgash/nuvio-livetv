[{"s":1795864120,"e":1795865788,"t":"The Cradle Robbers","d":"Fran wird beauftragt, Maggie davon zu überzeugen, nicht mit einem älteren Jungen auszugehen, doch beginnt stattdessen eine Beziehung mit dessen besten Freund.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/AT_USQT620324A_1060615563_2_20250716T192325633Z_135_imageprocessorclient-tvplus-linear-5db7c6bc99-cpflf.png"},{"s":1795865788,"e":1795867443,"t":"The Tart With Heart","d":"Nach der Rückkehr aus Paris nimmt Maxwell die liebenden Worte gegenüber Fran zurück.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/AT_USQT620324A_1060628982_3_20250716T192319577Z_132_imageprocessorclient-tvplus-linear-5db7c6bc99-cxmlx.png"},{"s":1795867443,"e":1795869119,"t":"The Rosie Show","d":"Fran wird auf Dauer für die Rosie O'Donnell Show engagiert.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/AT_USQT620324A_1060614988_7_20250716T192331923Z_94_imageprocessorclient-tvplus-linear-5db7c6bc99-gkp68.png"},{"s":1795869119,"e":1795870773,"t":"Frieda Needa Man","d":"Frans Tante Frieda kommt zu den Sheffields, nachdem sie rausgeschmissen wurde.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/AT_USQT620324A_1060611178_7_20250716T192318816Z_119_imageprocessorclient-tvplus-linear-5db7c6bc99-gkp68.png"},{"s":1795870773,"e":1795872449,"t":"Me And Mrs. Joan","d":"Fran organisiert ein Wiedersehen zwischen Maxwell und seinem ihm fremd gewordenen Vater.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/AT_USQT620324A_1060635550_0_20250716T192318703Z_101_imageprocessorclient-tvplus-linear-5db7c6bc99-w59hm.png"},{"s":1795872449,"e":1795874073,"t":"The Taxman Cometh","d":"Während sie auf Jay Lenos Hund aufpassen soll, wird Fran von einer ungelegenen Steuerprüfung abgelenkt.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/AT_USQT620324A_1060664765_6_20250716T192318358Z_62_imageprocessorclient-tvplus-linear-5db7c6bc99-cj6j4.png"},{"s":1795874073,"e":1795875746,"t":"An Affair To Dismember","d":"Fran überlegt, was sie gegen ihr lahmes Liebesleben unternehmen soll, als Maxwells gutaussehender jüngerer Bruder ihr einen Heiratsantrag macht.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/AT_USQT620324A_1060681508_7_20250716T192319052Z_70_imageprocessorclient-tvplus-linear-5db7c6bc99-gkp68.png"},{"s":1795875746,"e":1795877367,"t":"Tattoo","d":"Maxwell ist erregt, nachdem er erfährt, dass Fran ein geheimes Tattoo hat.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/AT_USQT620324A_1060611610_1_20250716T192325449Z_109_imageprocessorclient-tvplus-linear-5db7c6bc99-ljxfj.png"},{"s":1795877367,"e":1795878982,"t":"The Car Show","d":"Fran nimmt an einem Schönheitswettbewerb teil, um ein Auto für Maggies Geburtstag zu gewinnen.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/AT_USQT620324A_1060683274_1_20250716T192325449Z_48_imageprocessorclient-tvplus-linear-5db7c6bc99-ljxfj.png"},{"s":1795878982,"e":1795880615,"t":"Hurricane Fran","d":"Fran will einen Urlaub und eine Auszeit von den Sheffields und sitzt plötzlich in einem Orkan fest.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/AT_USQT620324A_1060702369_3_20250716T192323562Z_54_imageprocessorclient-tvplus-linear-5db7c6bc99-cxmlx.png"},{"s":1795880615,"e":1795882249,"t":"Danny's Dead And Who's Got The Will?","d":"Fran geht zur Beerdigung ihres ehemaligen Verlobten Danny, aus Angst einsam zu enden, drängt sie Maxwell zur Entscheidung.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/AT_USQT620324A_1060694214_4_20250716T192327397Z_108_imageprocessorclient-tvplus-linear-5db7c6bc99-xrkqv.png"},{"s":1795882249,"e":1795883853,"t":"Kissing Cousins","d":"Fran findet den perfekten Freund, nur um herauszufinden, dass er auch ihr Cousin ist.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/AT_USQT620324A_1060637124_4_20250716T192317873Z_77_imageprocessorclient-tvplus-linear-5db7c6bc99-xrkqv.png"},{"s":1795883853,"e":1795885488,"t":"The Fifth Wheel","d":"Auf Anraten ihres Therapeuten ist Fran entschlossen, alle Männer aus ihrem Leben zu verbannen.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/AT_USQT620324A_1060635818_1_20250716T192325450Z_67_imageprocessorclient-tvplus-linear-5db7c6bc99-ljxfj.png"},{"s":1795885488,"e":1795887081,"t":"Samson, He Denied Her","d":"Fran nimmt mit C.C. an der Gruppe der Geschworenen in einem umstrittenen Fall teil.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/AT_USQT620324A_1060635188_6_20250716T192318359Z_112_imageprocessorclient-tvplus-linear-5db7c6bc99-cj6j4.png"}]
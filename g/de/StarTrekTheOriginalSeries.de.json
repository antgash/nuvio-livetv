[{"s":1795854172,"e":1795857725,"t":"Raumschiff Enterprise","st":"Die Stunde der Erkenntnis","d":"Kirk versucht, einem primitiven Volk zu helfen, das von einem Computer namens Vaal beherrscht wird.","c":["Science fiction","Fantasy","Drama"],"i":"https://images.pluto.tv/series/696e2da0dee1ecbcdd39dc99/tile_1776902041534.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E05"},{"s":1795857725,"e":1795861279,"t":"Raumschiff Enterprise","st":"Planeten-Killer","d":"Die USS Enterprise trifft auf die havarierte USS Constellation und ihren verzweifelten Kommodore.","c":["Science fiction","Fantasy","Drama"],"i":"https://images.pluto.tv/series/696e2da0dee1ecbcdd39dc99/tile_1776902041534.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E06"},{"s":1795861279,"e":1795864831,"t":"Raumschiff Enterprise","st":"Das Spukschloss im Weltall","d":"Besucher, die ganz und gar nicht unserer Galaxie entspringen, versuchen, sich mit dem menschlichen Bewusstsein zu verbinden. Als sie scheitern, dringen sie in menschliche Albträume ein.","c":["Science fiction","Fantasy","Drama"],"i":"https://images.pluto.tv/series/696e2da0dee1ecbcdd39dc99/tile_1776902041534.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E07"},{"s":1795864831,"e":1795868378,"t":"Raumschiff Enterprise","st":"Der dressierte Herrscher","d":"Die Enterprise wird von einer Gruppe von Androiden eingenommen, die für Kirks alten Erzfeind, Harry Mudd, arbeiten.","c":["Science fiction","Fantasy","Drama"],"i":"https://images.pluto.tv/series/696e2da0dee1ecbcdd39dc99/tile_1776902041534.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E08"},{"s":1795868378,"e":1795871929,"t":"Raumschiff Enterprise","st":"Metamorphose","d":"Bei der Rückkehr zur Enterprise an Bord eines Shuttles werden Kirk, Spock, McCoy und ein schwerkranker Diplomat der Föderation von einer energetisierten Wolke entführt.","c":["Science fiction","Fantasy","Drama"],"i":"https://images.pluto.tv/series/696e2da0dee1ecbcdd39dc99/tile_1776902041534.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E09"},{"s":1795871929,"e":1795875472,"t":"Raumschiff Enterprise","st":"Reise nach Babel","d":"Die Spannungen nehmen zu, als die Enterprise Botschafter zu den Babel-Konferenzen befördert.","c":["Science fiction","Fantasy","Drama"],"i":"https://images.pluto.tv/series/696e2da0dee1ecbcdd39dc99/tile_1776902041534.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E10"},{"s":1795875472,"e":1795879025,"t":"Raumschiff Enterprise","st":"Im Namen des jungen Tiru","d":"Die Besatzung der Enterprise wird in einen lokalen Machtkampf auf einem Stammesplaneten verwickelt.","c":["Science fiction","Fantasy","Drama"],"i":"https://images.pluto.tv/series/696e2da0dee1ecbcdd39dc99/tile_1776902041534.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E11"},{"s":1795879025,"e":1795882572,"t":"Raumschiff Enterprise","st":"Wie schnell die Zeit vergeht","d":"Ein Landetrupp, darunter auch der Kommandostab, wird mit einer Krankheit infiziert, die zu raschem Altern und Senilität führt.","c":["Science fiction","Fantasy","Drama"],"i":"https://images.pluto.tv/series/696e2da0dee1ecbcdd39dc99/tile_1776902041534.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E12"},{"s":1795882572,"e":1795886112,"t":"Raumschiff Enterprise","st":"Tödliche Wolken","d":"Die Enterprise muss sich mit einer Kreatur aus Kirks Vergangenheit auseinandersetzen, die sich von menschlichem Blut ernährt.","c":["Science fiction","Fantasy","Drama"],"i":"https://images.pluto.tv/series/696e2da0dee1ecbcdd39dc99/tile_1776902041534.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E13"},{"s":1795886112,"e":1795889662,"t":"Raumschiff Enterprise","st":"Der Wolf im Schafspelz","d":"Kirk und der Computer der Enterprise werden zu Detektiven, als Scotty beschuldigt wird, auf einem Vergnügungsplaneten Frauen ermordet zu haben.","c":["Science fiction","Fantasy","Drama"],"i":"https://images.pluto.tv/series/696e2da0dee1ecbcdd39dc99/tile_1776902041534.jpg?fill=blur&fi
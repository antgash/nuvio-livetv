[{"s":1795862932,"e":1795868921,"t":"Lale Devri","d":"Çınar erkennt Zümrüts Intrige und weigert sich, mit Eda zu arbeiten. Toprak sieht es anders.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/DE_USQO570425A_2394478335_0_20261122T091511824Z_53_imageprocessorclient-tvplus-linear-b5879c6c6-zdvq4.jpeg"},{"s":1795868921,"e":1795875750,"t":"Lale Devri","d":"Zümrüt ist wütend über Çınars Rückkehr zur Firma. Der Machtkampf mit Toprak beginnt.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/DE_USQO570425A_2394503331_0_20261122T091511824Z_68_imageprocessorclient-tvplus-linear-b5879c6c6-zdvq4.jpeg"},{"s":1795875750,"e":1795881319,"t":"Lale Devri","d":"Münevver stirbt. Toprak ist verzweifelt und will verhindern, dass auch ihre Familie zerbricht.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/DE_USQO570425A_2400642389_0_20261124T163736378Z_101_imageprocessorclient-tvplus-linear-b5879c6c6-ldnh6.jpeg"},{"s":1795881319,"e":1795886863,"t":"Lale Devri","d":"Çınar kämpft ums Leben, Toprak um ihr Baby. Sultan entdeckt Zümrüts Verbrechen.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/DE_USQO570425A_2400713989_0_20261124T163736377Z_1_imageprocessorclient-tvplus-linear-b5879c6c6-ldnh6.jpeg"}]
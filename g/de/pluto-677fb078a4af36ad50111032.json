95904400,"e":1795907700,"t":"The Bionic Woman","st":"Max","d":"Der bionische Hund wird von ausländischen Agenten entführt, während Jaime im Krankenhaus ist.","c":["Adventure","Fantasy","Series"],"i":"https://images.pluto.tv/series/680ba43a30b839eca529c4e9/tile_1745593486101.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"20261128222000 +0000"},{"s":1795907700,"e":1795911000,"t":"Bionic Woman","st":"Over the Hill Spy","d":"Ein älterer Sowjet-Agent, den man für tot gehalten hatte, bedroht die Sicherheit der USA.","c":["Adventure","Fantasy","Series"],"i":"https://images.pluto.tv/series/69a19d3f390140d1aa5fa342/tile_1772199232666.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"20261128231500 +0000"},{"s":1795911000,"e":1795914300,"t":"The Bionic Woman","st":"All for One","d":"Jaime trifft im College einen Computerfreak, um herauszufinden, wer OSI bestohlen hat.","c":["Adventure","Fantasy","Series"],"i":"https://images.pluto.tv/series/680ba43a30b839eca529c4e9/tile_1745593486101.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"20261129001000 +0000"}]
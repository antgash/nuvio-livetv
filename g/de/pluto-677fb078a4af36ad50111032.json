[{"s":1795855080,"e":1795858260,"t":"The Bionic Woman","st":"Road to Nashville","d":"Jaime reist ins Zentrum der Country- und Western-Musikszene, wo sie sich als Country-Sängerin ausgibt, um Big Buck Buckley zu treffen und zu verhindern, dass streng geheime Informationen durch seine Musik weitergegeben werden.","c":["Adventure","Fantasy","Series"],"i":"https://images.pluto.tv/series/680ba43a30b839eca529c4e9/tile_1745593486101.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"20261128083800 +0000"},{"s":1795858260,"e":1795861560,"t":"The Bionic Woman","st":"Kill Oscar","d":"Ein Wissenschaftler, der sich ein OSI-Gerät wünscht, ersetzt Sekretäre durch Roboterdoppelgänger.","c":["Adventure","Fantasy","Series"],"i":"https://images.pluto.tv/series/680ba43a30b839eca529c4e9/tile_1745593486101.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"20261128093100 +0000"},{"s":1795861560,"e":1795864920,"t":"The Bionic Woman","st":"Black Magic","d":"Jaime gibt sich als Nichte eines Mannes aus, der das Vermögen seines Bruders erben will.","c":["Adventure","Fantasy","Series"],"i":"https://images.pluto.tv/series/680ba43a30b839eca529c4e9/tile_1745593486101.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"20261128102600 +0000"},{"s":1795864920,"e":1795868280,"t":"The Bionic Woman","st":"Jaime's Shield","d":"Jaime schreibt sich als Kadett an der Polizeiakademie ein, um einen Agenten ausfindig zu machen.","c":["Adventure","Fantasy","Series"],"i":"https://images.pluto.tv/series/680ba43a30b839eca529c4e9/tile_1745593486101.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"20261128112200 +0000"},{"s":1795868280,"e":1795871640,"t":"The Bionic Woman","st":"Biofeedback","d":"OSI-Kryptograf lehnt die Finanzierung der Biofeedback-Forschung seines Bruders ab.","c":["Adventure","Fantasy","Series"],"i":"https://images.pluto.tv/series/680ba43a30b839eca529c4e9/tile_1745593486101.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"20261128121800 +0000"},{"s":1795871640,"e":1795875000,"
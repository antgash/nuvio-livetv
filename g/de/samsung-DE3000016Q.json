[{"s":1795864120,"e":1795865788,"t":"The Cradle Robbers","d":"Fran wird beauftragt, Maggie davon zu überzeugen, nicht mit einem älteren Jungen auszugehen, doch beginnt stattdessen eine Beziehung mit dessen besten Freund.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/DE_USQT620324A_1060759806_1_20250716T204543982Z_35_imageprocessorclient-tvplus-linear-5db7c6bc99-grwzd.png"},{"s":1795865788,"e":1795867443,"t":"The Tart With Heart","d":"Nach der Rückkehr aus Paris nimmt Maxwell die liebenden Worte gegenüber Fran zurück.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/DE_USQT620324A_1060808612_9_20250716T204553329Z_99_imageprocessorclient-tvplus-linear-5db7c6bc99-q6tkt.png"},{"s":1795867443,"e":1795869119,"t":"The Rosie Show","d":"Fran wird auf Dauer für die Rosie O'Donnell Show engagiert.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/DE_USQT620324A_1060747802_12_20250716T204549349Z_134_imageprocessorclient-tvplus-linear-5db7c6bc99-trv6z.png"},{"s":1795869119,"e":1795870773,"t":"Frieda Needa Man","d":"Frans Tante Frieda kommt zu den Sheffields, nachdem sie rausgeschmissen wurde.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/DE_USQT620324A_1060795827_3_20250716T204544148Z_148_imageprocessorclient-tvplus-linear-5db7c6bc99-lcsnd.png"},{"s":1795870773,"e":1795872449,"t":"Me And Mrs. Joan","d":"Fran organisiert ein Wiedersehen zwischen Maxwell und seinem ihm fremd gewordenen Vater.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/DE_USQT620324A_1060767030_1_20250716T204543982Z_28_imageprocessorclient-tvplus-linear-5db7c6bc99-grwzd.png"},{"s":1795872449,"e":1795874073,"t":"The Taxman Cometh","d":"Während sie auf Jay Lenos Hund aufpassen soll, wird Fran von einer ungelegenen Steuerprüfung abgelenkt.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/DE_USQT620324A_1060737310_16_20250716T204552743Z_110_imageprocessorclient-tvplus-linear-5db7c6bc99-8fzp6.png"},{"s":1795874073,"e":1795875746,"t":"An Affair To Dismember","d":"Fran überlegt, was sie gegen ihr lahmes Liebesleben unternehmen soll, als Maxwells gutaussehender jüngerer Bruder ihr einen Heiratsantrag macht.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/DE_USQT620324A_1060792135_13_20250716T204545453Z_62_imageprocessorclient-tvplus-linear-5db7c6bc99-qhr8k.png"},{"s":1795875746,"e":1795877367,"t":"Tattoo","d":"Maxwell ist erregt, nachdem er erfährt, dass Fran ein geheimes Tattoo hat.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/DE_USQT620324A_1060787282_16_20250716T204550725Z_51_imageprocessorclient-tvplus-linear-5db7c6bc99-8fzp6.png"},{"s":1795877367,"e":1795878982,"t":"The Car Show","d":"Fran nimmt an einem Schönheitswettbewerb teil, um ein Auto für Maggies Geburtstag zu gewinnen.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/DE_USQT620324A_1060793250_12_20250716T204549349Z_132_imageprocessorclient-tvplus-linear-5db7c6bc99-trv6z.png"},{"s":1795878982,"e":1795880615,"t":"Hurricane Fran","d":"Fran will einen Urlaub und eine Auszeit von den Sheffields und sitzt plötzlich in einem Orkan fest.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/DE_USQT620324A_1060722776_3_20250716T204544149Z_151_imageprocessorclient-tvplus-linear-5db7c6bc99-lcsnd.png"},{"s":1795880615,"e":1795882249,"t":"Danny's Dead And Who's Got The Will?","d":"Fran geht zur Beerdigung ihres ehemaligen Verlobten Danny, aus Angst einsam zu enden, drängt sie Maxwell zur Entscheidung.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/DE_USQT620324A_1060760654_12_20250716T204549350Z_130_imageprocessorclient-tvplus-linear-5db7c6bc99-trv6z.png"},{"s":1795882249,"e":1795883853,"t":"Kissing Cousins","d":"Fran findet den perfekten Freund, nur um herauszufinden, dass er auch ihr Cousin ist.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/DE_USQT620324A_1060729784_8_20250716T204545006Z_71_imageprocessorclient-tvplus-linear-5db7c6bc99-q9lf2.png"},{"s":1795883853,"e":1795885488,"t":"The Fifth Wheel","d":"Auf Anraten ihres Therapeuten ist Fran entschlossen, alle Männer aus ihrem Leben zu verbannen.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/DE_USQT620324A_1060749535_3_20250716T204544149Z_150_imageprocessorclient-tvplus-linear-5db7c6bc99-lcsnd.png"},{"s":1795885488,"e":1795887081,"t":"Samson, He Denied Her","d":"Fran nimmt mit C.C. an der Gruppe der Geschworenen in einem umstrittenen Fall teil.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/DE_USQT620324A_1060801744_8_20250716T204545006Z_74_imageprocessorclient-tvplus-linear-5db7c6bc99-q9lf2.png"}]
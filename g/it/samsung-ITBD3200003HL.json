[{"s":1795863844,"e":1795867076,"t":"Andromeda","st":"Il peso (Parte 2)","d":"Beka viene scaricata su Seefra dopo che l'Andromeda è stata rubata. Dylan deve dimostrare che la nave gli appartiene.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_GBPBB1501FZ_1670669988_50_20260304T004229633Z_44_imageprocessorclient-tvplus-linear-85d7d49859-b9h9w.jpeg"},{"s":1795867076,"e":1795870308,"t":"Andromeda","st":"Il feromone della paura","d":"Ancora su Seefra, Dylan ritrova Harper, che si è adattato alla vita lì.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_GBPBB1501FZ_1670669344_21_20260304T004228487Z_51_imageprocessorclient-tvplus-linear-85d7d49859-fz6dc.jpeg"},{"s":1795870308,"e":1795873540,"t":"Andromeda","st":"La caduta dell'angelo","d":"Doyle è in realtà un androide costruito da Harper per contenere la programmazione di base di Rommie.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_GBPBB1501FZ_1670675215_10_20260304T004228278Z_22_imageprocessorclient-tvplus-linear-85d7d49859-s72h4.jpeg","ep":"S07E02"},{"s":1795873540,"e":1795876772,"t":"Andromeda","st":"L'escatologia del nostro presente","d":"Beka vince un premio da un DJ radiofonico, scopre la verità su Seefra e trova il diagramma Meethus.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_GBPBB1501FZ_1670666705_33_20260304T004228874Z_63_imageprocessorclient-tvplus-linear-85d7d49859-7ft59.jpeg"},{"s":1795876772,"e":1795880004,"t":"Andromeda","st":"Quando gira...","d":"Uno scienziato del vecchio Commonwealth fa la sua apparizione dopo essere rimasto intrappolato in un loop temporale.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_GBPBB1501FZ_1670673592_57_20260304T004229843Z_94_imageprocessorclient-tvplus-linear-85d7d49859-fz6dc.jpeg"},{"s":1795880004,"e":1795883236,"t":"Andromeda","st":"Tentato sermone","d":"Flavin ritorna, scatenando una guerra tra gang, e aiuta Dylan a svilupparsi come Paradine.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_GBPBB1501FZ_1670673667_3_20260304T004227926Z_113_imageprocessorclient-tvplus-linear-85d7d49859-m6g6v.jpeg"},{"s":1795883236,"e":1795886468,"t":"Andromeda","st":"Così bruciano le terre selvagge","d":"Viene scoperto un cristallo in grado di far tornare l'Andromeda alla sua vecchia potenza, ma per ottenerlo Dylan deve lavorare per il proprietario della miniera.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_GBPBB1501FZ_1670668483_5_20260304T004228084Z_79_imageprocessorclient-tvplus-linear-85d7d49859-bjc9b.jpeg"}]
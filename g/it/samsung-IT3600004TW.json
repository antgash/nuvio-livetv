[{"s":1795861287,"e":1795867872,"t":"Il segno del coyote","d":"Per vendicare i torti ai messicani, il figlio di un barone si finge collaboratore, ma è El Coyote.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_USQO570425A_852158943_0_20250502T185637731Z_66_imageprocessorclient-tvplus-linear-6fb5b47f79-m7gkj.png"},{"s":1795867872,"e":1795874418,"t":"I sette del Texas","d":"Il ricco texano Clifford, in viaggio per salvare la moglie, affronta minacce dai nativi.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_USQO570425A_852157696_0_20250502T185630447Z_1_imageprocessorclient-tvplus-linear-6fb5b47f79-m7gkj.png"},{"s":1795874418,"e":1795880275,"t":"Tutto per tutto","d":"A El Paso, l'indiano Faccia di Rame cerca vendetta contro il ladro Carranza per l'oro rubato.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_USQO570425A_852157877_0_20250502T185630447Z_108_imageprocessorclient-tvplus-linear-6fb5b47f79-m7gkj.png"},{"s":1795880275,"e":1795886067,"t":"L'ombra di Zorro","d":"I fratelli Billy e Dan vanno in California per uccidere Zorro e vendicare la morte del loro fratello.","i":"https://tvpnlogopeu.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/IT_USQO570425A_852159058_1_20250502T185639312Z_76_imageprocessorclient-tvplus-linear-6fb5b47f79-ctscq.png"}]
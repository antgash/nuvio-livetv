[{"s":1795854768,"e":1795857888,"t":"Star Trek: Voyager: Persistence Of Vision","st":"Persistence Of Vision","d":"A mysterious force puts the crew in a delusional state that causes their most deeply buried thoughts and desires to surface.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E08"},{"s":1795857888,"e":1795861008,"t":"Star Trek: Voyager: Tattoo","st":"Tattoo","d":"Chakotay is stranded on a planet inhabited by natives with ties to his ancestors.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E09"},{"s":1795861008,"e":1795864128,"t":"Star Trek: Voyager: Cold Fire","st":"Cold Fire","d":"Kes makes contact with Ocampa spacefarers and the female Caretaker, who may have the power to send the crew home.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E10"},{"s":1795864128,"e":1795867248,"t":"Star Trek: Voyager: Maneuvers","st":"Maneuvers","d":"The theft of a transporter module by Kazon forces thrusts Chakotay into an explosive confrontation with his traitorous former lover Seska.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E11"},{"s":1795867248,"e":1795870368,"t":"Star Trek: Voyager: Resistance","st":"Resistance","d":"Janeway must escape from a city under siege by the Mokra, a brutal regime determined to crush the growing resistance movement against it.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E12"},{"s":1795870368,"e":1795873488,"t":"Star Trek: Voyager: Prototype","st":"Prototype","d":"After Torres reactivates a humanoid robot, she's drawn into a war between robotic enemies.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E13"},{"s":1795873488,"e":1795876608,"t":"Star Trek: Voyager: Alliances","st":"Alliances","d":"Hoping to strengthen Voyager's strategic position in the quadrant, Janeway reluctantly seeks an alliance with the Kazon.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E14"},{"s":1795876608,"e":1795879728,"t":"Star Trek: Voyager: Threshold","st":"Threshold","d":"Paris makes history by becoming the first person to cross the transwarp threshold, but could pay for the achievement with his life.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E15"},{"s":1795879728,"e":1795882848,"t":"Star Trek: Voyager: Meld","st":"Meld","d":"Unable to come up with a logical motive for a shipboard murder, Tuvok performs a mind-meld with the perpetrator that brings out Tuvok's \"killer instinct.\"","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E16"},{"s":1795882848,"e":1795885968,"t":"Star Trek: Voyager: Dreadnought","st":"Dreadnought","d":"Torres races against time to stop a deadly self-guided missile on a collision course with disaster.","c":["Science fiction","Classic Sci-Fi & Fantasy","Series"]
[{"s":1795862552,"e":1795865619,"t":"정성으로 키웠다! 가을 보양식 상황버섯, 백봉오골계, 흑염소","d":"10만 마리의 백봉 오골계를 키우는 농장, 3천마리의 흑염소를 키우는 농장과 상황버섯 재배 농장을 찾아간다.","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/KR_USQT620324A_2823554017_0_20260422T040047021Z_23_imageprocessorclient-tvplus-linear-796646965d-bw4fq.jpeg"},{"s":1795865619,"e":1795868758,"t":"모래 위 불꽃 승부사 씨름선수","d":"지난해 스타선수들의 대거 이적과 해체위기 까지 겪었던 영암 씨름단의 선수들! 이들이 씨름대회의 메이저 경기인 2023 추석장사씨름대회에 참여해 ' 장사' 라는 타이틀을 얻기 위해 극강의 훈련을 이겨내는 피나는 노력의 현장과 모든 노력을 쏟아부으며 승부를 벌이는 치열한 모래판 위의 모습을 소개한다.","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/KR_USQT620324A_2823567710_0_20260422T040047018Z_99_imageprocessorclient-tvplus-linear-796646965d-bw4fq.jpeg"},{"s":1795868758,"e":1795871830,"t":"감칠맛 전쟁! 천연 조미료","d":"건강뿐만 아니라 음식의 맛과 풍미를 높여주는 천연 조미료를 만들기 위해 정성을 다하는 이들이 있다. 꽃게액젓, 동전 모양 고체 육수, 호두 기름까지. 건강에 좋은 천연 조미료를 만드는 사람들을 만나본다.","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/KR_USQT620324A_2823529862_1_20260422T040056008Z_18_imageprocessorclient-tvplus-linear-796646965d-xwfxt.jpeg"},{"s":1795871830,"e":1795874904,"t":"고물가 시대 소비 대안! 중고의 대변신","d":"중고 경매,중고 주방가구, 중고 옷","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/KR_USQT620324A_2823529866_1_20260422T040057009Z_30_imageprocessorclient-tvplus-linear-796646965d-xwfxt.jpeg"},{"s":1795874904,"e":1795877970,"t":"캄보디아, 물뱀 사냥과 맹그로브 숲의 게잡이","d":"맹그로브 숲에 서식하는 게을 잡아 생계를 이어가는 이들과 캄보디아 최대 호수인 톤레사프 호수에는 뱀을 잡으며 생계를 잇고 있는 이들의 삶을 살펴본다.","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/KR_USQT620324A_2823560963_1_20260422T040056010Z_52_imageprocessorclient-tvplus-linear-796646965d-xwfxt.jpeg"},{"s":1795877970,"e":1795881062,"t":"시간이 만든 맛 이색 소금과 훈연 멸치","d":"미세 플라스틱 없는 황토소금, 용솽로에 구운 불꽃 소금, 국물에 맛을 더해줄 훈연한 멸치","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/KR_USQT620324A_2823546996_3_20260422T040048912Z_88_imageprocessorclient-tvplus-linear-796646965d-9c7bx.jpeg"},{"s":1795881062,"e":1795884132,"t":"삭혀야 제맛! 젓갈의 세계","d":"인천 앞 바다의 '닻자망'을 이용한 젓새우 잡이, 충남 아산 젓갈 공장의 대량 새우젓 생산과정, 전남 여수의 명란젓,창난젓,어리굴젓 등 다양한 생산의 현장을 살펴본다.","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/KR_USQT620324A_2823554022_4_20260422T040050551Z_34_imageprocessorclient-tvplus-linear-796646965d-tj4fd.jpeg"},{"s":1795884132,"e":1795887198,"t":"캄보디아 오리 유목민과 블루크랩 어부","d":"캄보디아 15일에 한 번씩 자리를 옮겨가며 수천마리 오리를 키우며 사는 유목민, 캄보디아 바닷가 마을 켑의 유명 해산물 블루크랩을 잡는 어부 이야기","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/KR_USQT620324A_2823572604_1_20260422T040057009Z_75_imageprocessorclient-tvplus-linear-796646965d-xwfxt.jpeg"}]
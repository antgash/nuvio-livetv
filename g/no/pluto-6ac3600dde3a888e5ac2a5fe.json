[{"s":1795855238,"e":1795858265,"t":"Temptation Island USA","st":"Episode 511","d":"Kaitlin & Hall og Paris & Great gjenforenes til sine siste bålseremonier. Bål har en egen evne til å avdekke sannheten – selv om denne sannheten har vært en løgn.","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/6ac754897a5624e68dfca087/tile_1791448202083.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E11"},{"s":1795858265,"e":1795862860,"t":"Temptation Island USA","st":"Episode 512","d":"Parene og de single vender tilbake til en dramatisk gjenforening på 90 minutter etter tiden på øya.","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/6ac754897a5624e68dfca087/tile_1791448202083.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E12"},{"s":1795862860,"e":1795865887,"t":"Temptation Island USA","st":"Episode 513","d":"En time med tidligere usett materiale, inkludert dramatiske øyeblikk fra bålseremoniene, avsløringer fra deltakerne og mye mer.","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/6ac754897a5624e68dfca087/tile_1791448202083.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E13"},{"s":1795865887,"e":1795868914,"t":"Temptation Island USA","st":"Episode 401","d":"ire nye par tar en reise til Temptation Island for å se om forholdet deres tåler alt.","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/6ac754897a5624e68dfca087/tile_1791448202083.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S04E01"},{"s":1795868914,"e":1795871941,"t":"Temptation Island USA","st":"Episode 402","d":"Singlene flytter inn, og det går vilt for seg. Det første «bålet» byr på smertefulle oppvåkninger.","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/6ac754897a5624e68dfca087/tile_1791448202083.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S04E02"},{"s":1795871941,"e":1795874968,"t":"Temptation Island USA","st":"Episode 403",
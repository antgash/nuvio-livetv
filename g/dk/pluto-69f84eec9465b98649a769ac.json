[{"s":1795855682,"e":1795859745,"t":"Amalies Verden","st":"Afsnit 6","d":"Afsnit 6","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/696102d8a7396485f8facc98/tile_1789496641165.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E06"},{"s":1795859745,"e":1795862813,"t":"Amalies Verden","st":"Afsnit 1","d":"Endelig er Amalie tilbage. I sin helt egen verden, med sine helt egne regler og med sit helt eget sprog.","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/696102d8a7396485f8facc98/tile_1789496641165.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E01"},{"s":1795862813,"e":1795866070,"t":"Amalies Verden","st":"Afsnit 2","d":"I Amalies Verden er dagen kommet, hvor kæresten Peter skal i fodlænke. Han er dømt for vold mod Amalie, som i sin tid selv anmeldte ham, og nu skal han tage sin straf.","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/696102d8a7396485f8facc98/tile_1789496641165.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E02"},{"s":1795866070,"e":1795869343,"t":"Amalies Verden","st":"Afsnit 3","d":"Amalie kaster sig ud i det, hun kalder sit første voksen-arbejde. Hun skal nemlig være frontfigur for onkel Sebastians pokerportal, hvor hun blandt andet skal arrangere en stor pokerturnering for kendte danskere.","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/696102d8a7396485f8facc98/tile_1789496641165.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E03"},{"s":1795869343,"e":1795872657,"t":"Amalies Verden","st":"Afsnit 4","d":"Mor Lotte tager på ferie og Amalie, der er frontfigur for onkel Sebastians pokerportal, kaster sig ud i sin første pokerturnering.","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/696102d8a7396485f8facc98/tile_1789496641165.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E04"},{"s":1795872657,"e":1795875941,"t":"Amalies Verden","st":"Afsnit 5","d":"Amalie bliver tilbudt at lave sin helt egen blog, hvor hun skal skrive om sit liv, og alle de spændende ting hun oplever.","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/696102d8a7396485f8facc98/tile_1789496641165.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E05"},{"s":1795875941,"e":1795879093,"t":"Amalies Verden","st":"Afsnit 6","d":"I Amalies Verden er øjeblikket kommet, hvor mor Lottes store drøm bliver til virkelighed. Hun skal for første gang se portrættet af hende og Amalie i rokokokjoler, og synet af maleriet får Lottes tårer til at trille af begejstring.","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/696102d8a7396485f8facc98/tile_1789496641165.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E06"},{"s":1795879093,"e":1795882198,"t":"Amalies Verden","st":"Afsnit 7","d":"Amalie er frontfigur for onkel Sebastians pokerportal, og han har derfor spurgt, om hun vil hjælpe med at arrangere en stor pokerturnering.","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/696102d8a7396485f8facc98/tile_1789496641165.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E07"},{"s":1795882198,"e":1795885486,"t":"Amalies Verden","st":"Afsnit 8","d":"For Amalie åbner der sig en verden af nye muligheder, da hun får rollen i en \"dummie\" til DR sammen med andre kendte skuespillere.","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/696102d8a7396485f8facc98/tile_1789496641165.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E08"},{"s":1795885486,"e":1795888634,"t":"Amalies Verden","st":"Afsnit 9","d":"Amalie og Peter skal ud på en skole og holde foredrag for eleverne om, hvordan det er at være kendt.","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/696102d8a7396485f8facc98/tile_1789496641165.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E09"},{"s":1795888634,"e":1795892040,"t":"Amalies Verden","st":"Afsnit 10","d":"I sæsonens sidste afsnit af Amalies Verden er Danmarks reality-darling tættere på sin store drøm, end hun nogensinde har været før.","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/696102d8a7396485f8facc98/tile_1789496641165.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E10"},{"s":1795892040,"e":1795895444,"t":"Amalies Verden","st":"Afsnit 1","d":"Afsnit 1","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/696102d8a7396485f8facc98/tile_1789496641165.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E01"},{"s":1795895444,"e":1795898855,"t":"Amalies Verden","st":"Afsnit 2","d":"Afsnit 2","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/696102d8a7396485f8facc98/tile_1789496641165.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E02"},{"s":1795898855,"e":1795902179,"t":"Amalies Verden","st":"Afsnit 3","d":"Afsnit 3","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/696102d8a7396485f8facc98/tile_1789496641165.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E03"},{"s":1795902179,"e":1795905505,"t":"Amalies Verden","st":"Afsnit 4","d":"Afsnit 4","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/696102d8a7396485f8facc98/tile_1789496641165.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E04"},{"s":1795905505,"e":1795908957,"t":"Amalies Verden","st":"Afsnit 5","d":"Afsnit 5","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/696102d8a7396485f8facc98/tile_1789496641165.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E05"},{"s":1795908957,"e":1795912742,"t":"Amalies Verden","st":"Afsnit 6","d":"Afsnit 6","c":["Series","Reality","Human Interest"],"i":"https://images.pluto.tv/series/696102d8a7396485f8facc98/tile_1789496641165.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E06"},{"s":1795912742,"e":1795916191,"t":"Amalies Verden","st
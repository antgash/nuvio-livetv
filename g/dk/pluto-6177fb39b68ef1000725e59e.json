[{"s":1795854480,"e":1795857420,"t":"Andromeda: Fortabt i et rum, der ikke er der","st":"Fortabt i et rum, der ikke er der","d":"Afgrunden har smittet Beka. Besætningen må finde en måde at redde hende på.","c":["Science fiction","Adventure","Series"],"i":"https://images.pluto.tv/series/61bc649c0a7fe8001a07920a/tile_1776072601272.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S04E16"},{"s":1795857420,"e":1795860360,"t":"Andromeda: At forkortelse Djævelens kløft","st":"At forkortelse Djævelens kløft","d":"Efter at nogle af besætningsmedlemmerne er blevet taget til fange, tvinges Harper til at arbejde på en tidsbro for Patriarken.","c":["Science fiction","Adventure","Series"],"i":"https://images.pluto.tv/series/61bc649c0a7fe8001a07920a/tile_1776072601272.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S04E17"},{"s":1795860360,"e":1795863300,"t":"Andromeda","st":"At stole på den gordiske labyrint","d":"En spion fra Tri Gemma dukker op på Andromeda i et forsøg på at stjæle stjernekortet.","c":["Science fiction","Adventure","Series"],"i":"https://images.pluto.tv/series/61bc649c0a7fe8001a07920a/tile_1776072601272.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S04E18"},{"s":1795863300,"e":1795866180,"t":"Andromeda: En ufuldkommenhedens symmetri","st":"En ufuldkommenhedens symmetri","d":"Når Rommie bliver for følelsesladet, afskærer skibet hendes adgang til at udføre diagnostik.","c":["Science fiction","Adventure","Series"],"i":"https://images.pluto.tv/series/61bc649c0a7fe8001a07920a/tile_1776072601272.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S04E19"},{"s":1795866180,"e":1795869120,"t":"Andromeda: Tid uden for sindet","st":"Tid uden for sindet","d":"Abyss dræber Beckas ven, og besætningen må finde ud af, hvilke oplysninger de dræbte for at få fat i.","c":["Science fiction","Adventure","Series"],"i":"https://images.pluto.tv/series/61bc649c0a7fe8001a07920a/tile_1776072601272.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S04E20"},{"s":1795869120,"e":1795872060,"t":"Andromeda: Det dissonante interval (del 1)","st":"Det dissonante interval (del 1)","d":"Andromeda redder et skib, der vender tilbage fra fredsforhandlinger med Magog.","c":["Science fiction","Adventure","Series"],"i":"https://images.pluto.tv/series/61bc649c0a7fe8001a07920a/tile_1776072601272.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S04E21"},{"s":1795872060,"e":1795875000,"t":"Andromeda: Det dissonante interval (del 2)","st":"Det dissonante interval (del 2)","d":"Magog-angrebet har alvorlige konsekvenser. Andromeda bliver ødelagt, Trance og Dylan formodes at være de eneste overlevende, og Dylan flygter ud i tidernes rute","c":["Science fiction","Adventure","Series"],"i":"https://images.pluto.tv/series/61bc649c0a7fe8001a07920a/tile_1776072601272.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S04E22"},{"s":1795875000,"e":1795877940,"t":"Andromeda: Vægten (del 1)","st":"Vægten (del 1)","d":"Dylan ender på Seefra, hvor den overtroiske befolkning ikke har nogen teknologi.","c":["Science fiction","Adventure","Series"],"i":"https://images.pluto.tv/series/61bc649c0a7fe8001a07920a/tile_1776072601272.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E01"},{"s":1795877940,"e":1795880880,"t":"Andromeda: Vægten (del 2)","st":"Vægten (del 2)","d":"Beka bliver dumpet på Seefra, efter at Andromeda er blevet stjålet, og Dylan skal bevise, at skibet er hans.","c":["Science fiction","Adventure","Series"],"i":"https://images.pluto.tv/series/61bc649c0a7fe8001a07920a/tile_1776072601272.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E02"},{"s":1795880880,"e":1795883820,"t":"Andromeda: Phear Phactor Phenom","st":"Phear Phactor Phenom","d":"På Seefra finder Dylan dog Harper, som har tilpasset sig til livet der.","c":["Science fiction","Adventure","Series"],"i":"https://images.pluto.tv/series/61bc649c0a7fe8001a07920a/tile_1776072601272.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E03"},{"s":1795883820,"e":1795886760,"t":"Andromeda: Englens forfald","st":"Englens forfald","d":"Det viser sig, at Doyle er en android, som Harper har bygget til at indeholde Rommies kerneprogrammering.","c":["Science fiction","Adventure","Series"],"i":"https://images.pluto.tv/series/61bc649c0a7fe8001a07920a/tile_1776072601272.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E04"},{"s":1795886760,"e":1795889700,"t":"Andromeda: Eskatologien i vores nutid","st":"Eskatologien i vores nutid","d":"Beka vinder en pris fra en radio-DJ, lærer sandheden om Seefra og finder Meethus-diagrammet.","c":["Science fiction","Adventure","Series"],"i":"https://images.pluto.tv/series/61bc649c0a7fe8001a07920a/tile_1776072601272.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E05"},{"s":1795889700,"e":1795892640,"t":"Andromeda: Når det går rundt...","st":"Når det går rundt...","d":"En videnskabsmand fra det oprindelige Commonwealth dukker op og er fanget i en tidsløjfe.","c":["Science fiction","Adventure","Series"],"i":"https://images.pluto.tv/series/61bc649c0a7fe8001a07920a/tile_1776072601272.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E06"},{"s":1795892640,"e":1795895580,"t":"Andromeda: Forsøg på afretningslag","st":"Forsøg på afretningslag","d":"Flavin vender tilbage, hvilket udløser en bandekrig, og hjælper Dylan med at udvikle sig som Paradine.","c":["Science fiction","Adventure","Series"],"i":"https://images.pluto.tv/series/61bc649c0a7fe8001a07920a/tile_1776072601272.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E07"},{"s":1795895580,"e":1795898520,"t":"Andromeda: Så brænder de utæmmede lande","st":"Så brænder de utæmmede lande","d":"En krystal, der kan genoprette Andromedas kraft, bliver fundet, men for at få fat i den må Dylan arbejde for minens ejer.","c":["Science fiction","Adventure","Series"],"i":"https://images.pluto.tv/series/61bc649c0a7fe8001a07920a/tile_1776072601272.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E08"},{"s":1795898520,"e":1795901460,"t":"Andromeda: Hvad der vil ske, var ikke","st":"Hvad der vil ske, var ikke","d":"Der er opdaget tunneller på Seefra, som kan bruges til at nå otte andre Seefra-planeter.","c":["Science fiction","Adventure","Series"],"i":"https://images.pluto.tv/series/61bc649c0a7fe8001a07920a/tile_1776072601272.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E09"},{"s":1795901460,"e":1795904400,"t":"Andromeda: Prøven","st":"Prøven","d":"Da en gammel mand bliver dræbt, er Beka, Rhade og Harper de hovedmistænkte og skal for retten.","c":["Science fiction","Adventure","Series"],"i":"https://images.pluto.tv/series/61bc649c0a7fe8001a07920a/tile_1776072601272.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E10"},{"s":1795904400,"e":1795907340,"t":"Andromeda: Gennem et mørkt glas","st":"Gennem et mørkt glas","d":"Rhade leder oprørerne i en kamp mod en krigsherre på Seefra-5.","c":["Science fiction","Adventure","Series"],"i":"https://images.pluto.tv/series/61bc649c0a7fe8001a07920a/tile_1776072601272.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E11"},{"s":1795907340,"e":1795910280,"t":"Andromeda: Stolthed før faldet","st":"Stolthed før faldet","d":"Dylan finder ud af, at Bekas kæreste var Drago Musevini, og at han brugte Bekas DNA til at skabe nietzscheanerne.","c":["Science fiction","Adventure","Series"],"i":"https://images.pluto.tv/series/61bc649c0a7fe8001a07920a/tile_1776072601272.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E12"},{"s":1795910280,"e":1795913220,"t":"Andromeda: Måneskin bliver til dig","st":"Måneskin bliver til dig","d":"Beka og Rhade finder en prøve, der enten vil give dem stor rigdom eller drive dem til vanvid.","c":["Science fiction","Adventure","Series"],"i":"https://images.pluto.tv/series/61bc649c0a7fe8001a07920a/tile_1776072601272.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E13"},{"s":1795913220,"e":1795916160,"t":"Andromeda: Fortiden er uendelig","st":"Fortiden er uendelig","d":"Harper opdager et program, der kan ødelægge otte af Seefra-planeterne og dræbe millioner af mennesker.","c":["Science fiction","Adventure","Series"],"i":"https://images.pluto.tv/series/61bc649c0a7fe8001a07920a/tile_1776072601272.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S05E14"}]